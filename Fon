<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>CHANDAN F&O BREAKOUT SCANNER</title>

<style>
*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#080d19;
    color:#fff;
}

.header{
    padding:20px;
    background:#111a2d;
    border-bottom:1px solid #263452;
}

.logo{
    font-size:23px;
    font-weight:bold;
}

.sub{
    margin-top:7px;
    color:#9eabc5;
    font-size:13px;
}

.status{
    margin-top:15px;
    display:flex;
    justify-content:space-between;
    background:#0b1425;
    padding:12px;
    border-radius:10px;
}

.open{
    color:#38e58b;
    font-weight:bold;
}

.closed{
    color:#ff647c;
    font-weight:bold;
}

.cards{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
    padding:15px;
}

.card{
    background:#131e34;
    border-radius:13px;
    padding:16px 8px;
    text-align:center;
}

.card-title{
    color:#9eabc5;
    font-size:12px;
}

.number{
    font-size:28px;
    margin-top:7px;
    font-weight:bold;
}

.buy{
    color:#39e58a;
}

.watch{
    color:#ffd166;
}

.down{
    color:#ff647c;
}

.table-box{
    overflow-x:auto;
    padding:0 10px;
}

table{
    width:100%;
    min-width:720px;
    border-collapse:collapse;
    background:#10192b;
}

th{
    color:#8998b5;
    font-size:12px;
    padding:13px 8px;
    border-bottom:1px solid #283653;
}

td{
    padding:13px 8px;
    text-align:center;
    border-bottom:1px solid #202d47;
    font-size:13px;
}

.signal-buy{
    color:#39e58a;
    font-weight:bold;
}

.signal-watch{
    color:#ffd166;
    font-weight:bold;
}

.setup{
    margin:15px;
    padding:18px;
    background:#131e34;
    border-radius:14px;
}

.setup-title{
    font-size:17px;
    font-weight:bold;
    margin-bottom:15px;
}

.setup-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
}

.setup-box{
    background:#0b1425;
    padding:14px 5px;
    text-align:center;
    border-radius:10px;
}

.setup-label{
    color:#8998b5;
    font-size:11px;
}

.setup-value{
    margin-top:7px;
    font-size:18px;
    font-weight:bold;
}

.footer{
    text-align:center;
    color:#65738e;
    padding:20px;
    font-size:11px;
}

@media(max-width:600px){

    .cards{
        grid-template-columns:repeat(3,1fr);
    }

    .number{
        font-size:21px;
    }

    .setup-grid{
        grid-template-columns:1fr;
    }

}
</style>
</head>


<body>

<div class="header">

<div class="logo">
CHANDAN F&O BREAKOUT SCANNER
</div>

<div class="sub">
NSE F&O • Futures • Price Action • Volume • OI
</div>

<div class="status">

<div id="marketStatus">
Checking Market...
</div>

<div id="clock">
--:--:--
</div>

</div>

</div>


<div class="cards">

<div class="card">
<div class="card-title">BUY</div>
<div id="buyCount" class="number buy">0</div>
</div>

<div class="card">
<div class="card-title">WATCH</div>
<div id="watchCount" class="number watch">0</div>
</div>

<div class="card">
<div class="card-title">BREAKDOWN</div>
<div id="downCount" class="number down">0</div>
</div>

</div>


<div class="table-box">

<table>

<thead>

<tr>
<th>STOCK</th>
<th>PRICE</th>
<th>RESISTANCE</th>
<th>VOL</th>
<th>OI CHANGE</th>
<th>EMA20</th>
<th>SIGNAL</th>
</tr>

</thead>

<tbody id="scannerTable">

</tbody>

</table>

</div>


<div class="setup">

<div class="setup-title">
🟢 SELECTED BUY SETUP
</div>

<div id="selectedStock">
No confirmed BUY setup
</div>

<div class="setup-grid">

<div class="setup-box">
<div class="setup-label">ENTRY</div>
<div id="entry" class="setup-value">—</div>
</div>

<div class="setup-box">
<div class="setup-label">STOP LOSS</div>
<div id="sl" class="setup-value">—</div>
</div>

<div class="setup-box">
<div class="setup-label">TARGET 1:2</div>
<div id="target" class="setup-value">—</div>
</div>

</div>

</div>


<div class="footer">

Private CHANDAN Scanner • For personal use

</div>


<script>

/*
=========================================================
CHANDAN F&O SCANNER
LIVE API ENDPOINT
=========================================================

আপনার backend তৈরি হলে এখানে URL বসাবেন:

const API_URL =
"https://YOUR-SERVER-DOMAIN/api/scanner";

API থেকে এই format-এ data আসবে:

{
 "stocks":[
   {
     "symbol":"ABC",
     "price":1251,
     "resistance":1248,
     "volume_ratio":1.85,
     "oi_change":21,
     "ema20":1235,
     "signal":"BUY",
     "entry":1251,
     "sl":1238,
     "target":1277
   }
 ]
}

=========================================================
*/


const API_URL = "";


/* DEMO DATA
   API connect না হওয়া পর্যন্ত page-এর design test হবে
*/

const demoData = {

stocks:[

{
symbol:"ABC",
price:1251,
resistance:1248,
volume_ratio:1.85,
oi_change:21,
ema20:1235,
signal:"BUY",
entry:1251,
sl:1238,
target:1277
},

{
symbol:"PQR",
price:1560,
resistance:1555,
volume_ratio:2.10,
oi_change:28,
ema20:1528,
signal:"BUY",
entry:1560,
sl:1540,
target:1600
},

{
symbol:"XYZ",
price:842,
resistance:845,
volume_ratio:1.20,
oi_change:12,
ema20:830,
signal:"WATCH",
entry:null,
sl:null,
target:null
}

]

};


/* MARKET CLOCK */

function updateClock(){

const now = new Date();

const h = now.getHours();
const m = now.getMinutes();
const s = now.getSeconds();

document.getElementById("clock")
.innerText =
String(h).padStart(2,"0")+":"+
String(m).padStart(2,"0")+":"+
String(s).padStart(2,"0");


const current =
h*60+m;

const marketOpen =
current >= 9*60+15 &&
current <= 15*60+30;


const status =
document.getElementById("marketStatus");


if(marketOpen){

status.innerHTML =
"🟢 MARKET OPEN";

status.className="open";

}else{

status.innerHTML =
"🔴 MARKET CLOSED";

status.className="closed";

}

}


/* RENDER SCANNER */

function renderScanner(data){

const stocks =
data.stocks || [];


let buys = 0;
let watches = 0;
let breakdown = 0;

let html = "";

let selected = null;


stocks.forEach(stock=>{

if(stock.signal==="BUY"){

buys++;

if(!selected){
selected=stock;
}

}

if(stock.signal==="WATCH"){
watches++;
}

if(stock.signal==="BREAKDOWN"){
breakdown++;
}


const signalClass =
stock.signal==="BUY"
? "signal-buy"
: "signal-watch";


html += `

<tr>

<td>${stock.symbol}</td>

<td>₹${stock.price}</td>

<td>₹${stock.resistance}</td>

<td>${stock.volume_ratio}x</td>

<td>${stock.oi_change}%</td>

<td>${stock.ema20}</td>

<td class="${signalClass}">
${stock.signal}
</td>

</tr>

`;

});


document.getElementById("buyCount")
.innerText=buys;

document.getElementById("watchCount")
.innerText=watches;

document.getElementById("downCount")
.innerText=breakdown;

document.getElementById("scannerTable")
.innerHTML=html;


/* SELECTED BUY */

if(selected){

document.getElementById("selectedStock")
.innerHTML=
"<b>"+selected.symbol+"</b> — BREAKOUT CONFIRMED";

document.getElementById("entry")
.innerText=
"₹"+selected.entry;

document.getElementById("sl")
.innerText=
"₹"+selected.sl;

document.getElementById("target")
.innerText=
"₹"+selected.target;

}

}


/* LOAD DATA */

async function loadScanner(){

try{

if(!API_URL){

renderScanner(demoData);

return;

}

const response =
await fetch(API_URL);

const data =
await response.json();

renderScanner(data);

}catch(error){

console.log("API connection error");

renderScanner(demoData);

}

}


/* START */

updateClock();

loadScanner();

setInterval(updateClock,1000);

setInterval(loadScanner,5000);

</script>

</body>

</html>
